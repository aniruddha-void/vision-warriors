# ==========================================
# Nova Insights — Frontend Environment Configuration Template
# NOTE: Only variables prefixed with VITE_ are exposed to the client application.
# NEVER put secrets, private keys, database strings, or passwords here.
# ==========================================

# Public API Base URL
# For local development with Vite proxy: /api
# For direct backend or separate origin: http://localhost:5000/api
# For production deployment: https://api.yourdomain.com/api
VITE_API_BASE_URL=/api
