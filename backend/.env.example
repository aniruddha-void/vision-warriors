# ==========================================
# Nova Insights — Backend Environment Configuration Template
# NOTE: Do NOT place real production secrets or credentials in this file.
# Copy this file to .env and configure appropriate values for your environment.
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection String
# Local: mongodb://127.0.0.1:27017/nova_insights
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nova_insights?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nova_insights

# JWT Secret & Expiration
# In production, generate a secure random 256-bit secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret
JWT_EXPIRES_IN=7d

# Frontend URL (Used for CORS whitelist, OTP & password reset links, and customer consent portal URLs)
# Local: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Allowed Origins for CORS (comma-separated for multi-domain or staging environments)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Outbound Email Service (Nodemailer / Gmail SMTP)
# If omitted or left blank, outbound emails run in safe simulation mode (logged to console)
# For production Gmail SMTP, use an App Password generated at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Nova Insights <no-reply@novainsights.com>
